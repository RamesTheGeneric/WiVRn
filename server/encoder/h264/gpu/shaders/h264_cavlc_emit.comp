#version 460
#extension GL_GOOGLE_include_directive : require
// Parallel CAVLC emit (PyroWave-style, intra-MB parallel): one WORKGROUP of 32
// lanes per macroblock. An MB's bitstream is a fixed concatenation of up to 28
// independent "segments" -- the MB header, the luma DC block, 16 luma AC blocks,
// 2 chroma DC blocks and 8 chroma AC blocks. Each lane owns one segment: it
// computes its segment's bit length (count pass), a tiny 28-element prefix-sum
// gives per-segment bit offsets, then each lane re-runs its segment writing the
// bits at its offset into the per-MB scratch (atomicOr merges the shared
// boundary words). CAVLC has no serial cross-MB state (nC comes from neighbour
// coefficient COUNTS in the recon nnz grid), and within an MB the segments are
// independent, so this exposes ~28x more parallelism than one-lane-per-MB.
// Faithful port of cpu_encoder264's per-MB syntax + cavlc.cpp residual_block:
// count and write share the exact same code path (put_bit mode flag) so they
// cannot diverge.
layout(local_size_x = 32) in;

layout(set = 0, binding = 0, std430) readonly buffer LDC { int v[]; } ldc;   // [nmb*16]
layout(set = 0, binding = 1, std430) readonly buffer LAC { int v[]; } lac;   // [nmb*256]
layout(set = 0, binding = 2, std430) readonly buffer CDC { int v[]; } cdc;   // [nmb*8]
layout(set = 0, binding = 3, std430) readonly buffer CAC { int v[]; } cac;   // [nmb*128]
layout(set = 0, binding = 4, std430) readonly buffer NNZL { uint v[]; } nnzL; // global luma 4x4 grid
layout(set = 0, binding = 5, std430) readonly buffer NNZC { uint v[]; } nnzC; // global chroma 4x4 grid [2*cgw*cgh]
layout(set = 0, binding = 6, std430) buffer Scratch { uint v[]; } scratch;    // [nmb*stride_words]
layout(set = 0, binding = 7, std430) writeonly buffer BitLen { uint v[]; } bitLen; // [nmb]

layout(push_constant) uniform PC {
	uint mbw, mbh;
	uint stride_words;
	uint lgw, cgw, cgh; // luma grid width, chroma grid width/height
} pc;

#include "cavlc_tables.glsl.inc"

const int zblk_bx[16] = int[16](0, 1, 0, 1, 2, 3, 2, 3, 0, 1, 0, 1, 2, 3, 2, 3);
const int zblk_by[16] = int[16](0, 0, 1, 1, 0, 0, 1, 1, 2, 2, 3, 3, 2, 2, 3, 3);

// ---- per-invocation bit sink (per lane / per segment) ----
// bw_mode 0 = count only; 1 = pack into lbuf (MSB-first, word 0 = first bits).
int  bw_mode;
uint lbuf[24];   // one segment's bits; max ~600 bits for a dense 4x4 block
uint bw_cur; int bw_n; uint bw_word; uint bw_bits;

void bw_reset() { bw_cur = 0u; bw_n = 0; bw_word = 0u; bw_bits = 0u; }
void put_bit(uint b)
{
	++bw_bits;
	if (bw_mode == 1) {
		bw_cur = (bw_cur << 1) | (b & 1u);
		if (++bw_n == 32) { lbuf[bw_word] = bw_cur; ++bw_word; bw_cur = 0u; bw_n = 0; }
	}
}
void put_bits(uint v, int n) { for (int i = n - 1; i >= 0; --i) put_bit((v >> uint(i)) & 1u); }
void bw_flush_local() { if (bw_n > 0) { lbuf[bw_word] = bw_cur << uint(32 - bw_n); ++bw_word; bw_cur = 0u; bw_n = 0; } }

void put_ue(uint v)
{
	uint code = v + 1u;
	int n = 0; uint t = code; while (t > 1u) { t >>= 1u; ++n; }
	for (int i = 0; i < n; ++i) put_bit(0u);
	put_bits(code, n + 1);
}
void put_se(int v)
{
	uint k = (v <= 0) ? uint(-2 * v) : uint(2 * v - 1);
	put_ue(k);
}

// ---- residual_block (port of cavlc.cpp) ----
void write_coeff_token(int total, int t1, int nC, bool chroma_dc)
{
	int idx = total * 4 + t1;
	if (chroma_dc) { put_bits(cdc_ctk_bits[idx], int(cdc_ctk_len[idx])); return; }
	int tb = nC < 2 ? 0 : (nC < 4 ? 1 : (nC < 8 ? 2 : 3));
	put_bits(ctk_bits[tb * 68 + idx], int(ctk_len[tb * 68 + idx]));
}
void write_level(int level_code, int sl)
{
	int prefix, suffix = 0, ssize = 0;
	if (sl == 0) {
		if (level_code < 14) prefix = level_code;
		else if (level_code < 30) { prefix = 14; suffix = level_code - 14; ssize = 4; }
		else { prefix = 15; suffix = level_code - 30; ssize = 12; }
	} else {
		prefix = level_code >> sl;
		if (prefix < 15) { suffix = level_code & ((1 << sl) - 1); ssize = sl; }
		else { prefix = 15; suffix = level_code - (15 << sl); ssize = 12; }
	}
	for (int i = 0; i < prefix; ++i) put_bit(0u);
	put_bit(1u);
	if (ssize > 0) put_bits(uint(suffix), ssize);
}

// levels are read via an accessor: which=0 LDC, 1 LAC, 2 CDC, 3 CAC.
int g_which; uint g_base; // base index into the chosen buffer
int lev(int scanRaster)
{
	if (g_which == 0) return ldc.v[g_base + uint(scanRaster)];
	if (g_which == 1) return lac.v[g_base + uint(scanRaster)];
	if (g_which == 2) return cdc.v[g_base + uint(scanRaster)];
	return cac.v[g_base + uint(scanRaster)];
}

void residual_block(int count, int nC, bool chroma_dc, int scankind)
{
	int run[16]; int lvl[16];
	int total = 0, total_zeros = 0, last = -1;
	for (int s = count - 1; s >= 0; --s) {
		int r = (scankind == 0) ? int(zigzag4[s]) : (scankind == 1 ? int(zigzag4[s + 1]) : s);
		if (lev(r) != 0) { last = s; break; }
	}
	if (last >= 0) {
		int run_acc = 0;
		for (int s = last; s >= 0; --s) {
			int r = (scankind == 0) ? int(zigzag4[s]) : (scankind == 1 ? int(zigzag4[s + 1]) : s);
			int val = lev(r);
			if (val != 0) { lvl[total] = val; if (total >= 1) run[total - 1] = run_acc; ++total; run_acc = 0; }
			else ++run_acc;
		}
		total_zeros = last + 1 - total;
	}
	int t1 = 0;
	while (t1 < total && t1 < 3 && abs(lvl[t1]) == 1) ++t1;
	write_coeff_token(total, t1, nC, chroma_dc);
	if (total == 0) return;
	for (int i = 0; i < t1; ++i) put_bit(lvl[i] < 0 ? 1u : 0u);
	int sl = (total > 10 && t1 < 3) ? 1 : 0;
	for (int i = t1; i < total; ++i) {
		int level = lvl[i];
		int lc = (level > 0) ? ((level << 1) - 2) : ((-level << 1) - 1);
		if (i == t1 && t1 < 3) lc -= 2;
		write_level(lc, sl);
		if (sl == 0) sl = 1;
		if (abs(level) > (3 << (sl - 1)) && sl < 6) ++sl;
	}
	if (total < count) {
		if (chroma_dc) put_bits(cdc_tz_bits[(total - 1) * 4 + total_zeros], int(cdc_tz_len[(total - 1) * 4 + total_zeros]));
		else put_bits(tz_bits[(total - 1) * 16 + total_zeros], int(tz_len[(total - 1) * 16 + total_zeros]));
	}
	int zl = total_zeros;
	for (int i = 0; i < total - 1; ++i) {
		if (zl <= 0) break;
		int tk = (zl < 7 ? zl : 7) - 1;
		put_bits(run_bits[tk * 16 + run[i]], int(run_len[tk * 16 + run[i]]));
		zl -= run[i];
	}
}

int nC_luma(int gx, int gy)
{
	bool a = gx > 0, b = gy > 0;
	int nA = a ? int(nnzL.v[uint(gy) * pc.lgw + uint(gx - 1)]) : 0;
	int nB = b ? int(nnzL.v[uint(gy - 1) * pc.lgw + uint(gx)]) : 0;
	if (a && b) return (nA + nB + 1) >> 1;
	if (a) return nA;
	if (b) return nB;
	return 0;
}
int nC_chroma(int comp, int gx, int gy)
{
	uint base = uint(comp) * (pc.cgw * pc.cgh);
	bool a = gx > 0, b = gy > 0;
	int nA = a ? int(nnzC.v[base + uint(gy) * pc.cgw + uint(gx - 1)]) : 0;
	int nB = b ? int(nnzC.v[base + uint(gy - 1) * pc.cgw + uint(gx)]) : 0;
	if (a && b) return (nA + nB + 1) >> 1;
	if (a) return nA;
	if (b) return nB;
	return 0;
}

// ---- shared per-MB state ----
shared uint hnz[32];   // per-segment "has any relevant nonzero" (for cbp)
shared uint seglen[32]; // per-segment bit length
shared uint segoff[32]; // per-segment absolute bit offset within the MB
shared int  s_cbpL, s_cbpC;
shared uint s_total;

// Run segment `seg` for macroblock (mbx,mby) in the given bw_mode; returns its
// bit length. seg 0 = header, seg 1 = luma DC, 2..17 = luma AC (zig block
// order), 18..19 = chroma DC (Cb,Cr), 20..27 = chroma AC (Cb0..3, Cr0..3).
uint run_segment(uint seg, uint mb, uint mbx, uint mby, int cbpL, int cbpC, int mode)
{
	bw_mode = mode; bw_reset();
	if (seg == 0u) {
		int mb_type = 1 + 2 + 4 * cbpC + 12 * ((cbpL == 15) ? 1 : 0);
		put_ue(uint(mb_type));
		put_ue(0u); // intra_chroma_pred_mode = DC
		put_se(0);  // mb_qp_delta
	} else if (seg == 1u) {
		g_which = 0; g_base = mb * 16u;
		residual_block(16, nC_luma(int(mbx) * 4, int(mby) * 4), false, 0);
	} else if (seg <= 17u) {
		if (cbpL != 0) {
			int zi = int(seg) - 2;
			int bx = zblk_bx[zi], by = zblk_by[zi];
			g_which = 1; g_base = mb * 256u + uint(by * 4 + bx) * 16u;
			residual_block(15, nC_luma(int(mbx) * 4 + bx, int(mby) * 4 + by), false, 1);
		}
	} else if (seg <= 19u) {
		if ((cbpC & 3) != 0) {
			int comp = int(seg) - 18;
			g_which = 2; g_base = mb * 8u + uint(comp) * 4u;
			residual_block(4, -1, true, 2);
		}
	} else {
		if ((cbpC & 2) != 0) {
			int idx = int(seg) - 20;
			int comp = idx / 4, sb = idx % 4;
			int bx = sb & 1, by = sb >> 1;
			g_which = 3; g_base = mb * 128u + uint(comp) * 64u + uint(sb) * 16u;
			residual_block(15, nC_chroma(comp, int(mbx) * 2 + bx, int(mby) * 2 + by), false, 1);
		}
	}
	if (mode == 1) bw_flush_local();
	return bw_bits;
}

void main()
{
	uint seg = gl_LocalInvocationID.x; // 0..31
	uint mb = gl_WorkGroupID.x;
	uint nmb = pc.mbw * pc.mbh;
	if (mb >= nmb) return;
	uint mbx = mb % pc.mbw, mby = mb / pc.mbw;
	uint wbase = mb * pc.stride_words;

	// ---- phase 0: per-segment "has nonzero" for cbp ----
	uint nz = 0u;
	if (seg >= 2u && seg <= 17u) {           // luma AC blocks
		int zi = int(seg) - 2;
		int bx = zblk_bx[zi], by = zblk_by[zi];
		uint bb = mb * 256u + uint(by * 4 + bx) * 16u;
		for (int k = 1; k < 16; ++k) if (lac.v[bb + uint(k)] != 0) nz = 1u;
	} else if (seg >= 18u && seg <= 19u) {   // chroma DC (Cb, Cr)
		uint bb = mb * 8u + uint(int(seg) - 18) * 4u;
		for (int k = 0; k < 4; ++k) if (cdc.v[bb + uint(k)] != 0) nz = 1u;
	} else if (seg >= 20u && seg <= 27u) {   // chroma AC
		int idx = int(seg) - 20;
		uint bb = mb * 128u + uint(idx / 4) * 64u + uint(idx % 4) * 16u;
		for (int k = 1; k < 16; ++k) if (cac.v[bb + uint(k)] != 0) nz = 1u;
	}
	hnz[seg] = nz;
	barrier();
	if (seg == 0u) {
		uint anyLAC = 0u; for (uint i = 2u; i <= 17u; ++i) anyLAC |= hnz[i];
		uint anyCDC = 0u; for (uint i = 18u; i <= 19u; ++i) anyCDC |= hnz[i];
		uint anyCAC = 0u; for (uint i = 20u; i <= 27u; ++i) anyCAC |= hnz[i];
		s_cbpL = (anyLAC != 0u) ? 15 : 0;
		s_cbpC = (anyCAC != 0u) ? 2 : ((anyCDC != 0u) ? 1 : 0);
	}
	barrier();
	int cbpL = s_cbpL, cbpC = s_cbpC;

	// ---- phase 1: per-segment bit length (count pass) ----
	seglen[seg] = (seg < 28u) ? run_segment(seg, mb, mbx, mby, cbpL, cbpC, 0) : 0u;
	barrier();

	// ---- phase 2: exclusive prefix-sum over the 28 segments (lane 0) ----
	if (seg == 0u) {
		uint acc = 0u;
		for (uint i = 0u; i < 28u; ++i) { segoff[i] = acc; acc += seglen[i]; }
		s_total = acc;
	}
	barrier();

	// zero only the words the writes will touch (ceil(total/32)+1), then barrier
	// before the atomicOr writes. Sparse MBs use a handful of words, not all 256.
	uint nw = min((s_total + 31u) / 32u + 1u, pc.stride_words);
	for (uint i = seg; i < nw; i += 32u) scratch.v[wbase + i] = 0u;
	barrier();

	// ---- phase 3: write each segment's bits at its offset (write pass) ----
	if (seg < 28u && seglen[seg] > 0u) {
		run_segment(seg, mb, mbx, mby, cbpL, cbpC, 1); // fills lbuf[0..bw_word)
		uint off = segoff[seg];
		uint w0 = off >> 5u, sh = off & 31u;
		for (uint i = 0u; i < bw_word; ++i) {
			uint val = lbuf[i];
			atomicOr(scratch.v[wbase + w0 + i], val >> sh);
			if (sh != 0u && (w0 + i + 1u) < pc.stride_words)
				atomicOr(scratch.v[wbase + w0 + i + 1u], val << (32u - sh));
		}
	}
	if (seg == 0u) bitLen.v[mb] = s_total;
}
